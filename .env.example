# Settings for the operator scripts (uv run stack|chat|guardrail|kb-data|hr-db|rag-eval).
# Optional: copy to .env and adjust. Values missing from .env fall back to this file.
# The agent itself is configured in agentcore/agentcore.json (runtimes[].envVars).

# AWS region and SSO profile (leave AWS_PROFILE empty to use the default credential chain)
AWS_REGION=us-west-2
AWS_PROFILE=

# Must match agentcore/agentcore.json: project name, runtime name, KB name
PROJECT_NAME=IcAgentcoreDemo
RUNTIME_NAME=HrAssistant
KB_NAME=HrDocs
# Empty = read the runtime ARN from agentcore/.cli/deployed-state.json after `agentcore deploy`
RUNTIME_ARN=

# S3 bucket with the HR handbook; the KB data source in agentcore.json points to s3://KB_BUCKET/KB_PREFIX.
# {account} = account id of the current AWS credentials (bucket names are global)
KB_BUCKET=ic-agentcore-demo-kb-{account}
KB_PREFIX=hr/

# HR database (Aurora PostgreSQL Serverless v2 + Data API), `uv run hr-db create`.
# The EmployeeDirectory Lambda hardcodes the same names (the CLI can't pass it env vars).
DB_CLUSTER=ic-agentcore-demo-hr
DB_NAME=hr
DB_READER_SECRET=ic-agentcore-demo/hr-db/reader
# Empty = hr-db creates its own isolated VPC named DB_CLUSTER (no internet access; the Data API needs
# no networking) and deletes it on `hr-db delete`. Set to reuse an existing VPC (it is then never deleted).
DB_VPC_ID=

# Bedrock guardrail. `uv run guardrail create` writes GUARDRAIL_ID/GUARDRAIL_VERSION into agentcore.json
GUARDRAIL_NAME=ic-agentcore-demo-hr
GUARDRAIL_BLOCKED_INPUT="Sorry, I can't help with that request. For HR questions about specific people, contact hr@quibblefrost.example."
GUARDRAIL_BLOCKED_OUTPUT="Sorry, I can't give a reliable answer from the HR handbook. Please contact hr@quibblefrost.example."

# Bedrock RAG evaluation job (`uv run rag-eval start`): generator and judge models, IAM role name
RAG_EVAL_GENERATOR_MODEL=us.anthropic.claude-sonnet-5
RAG_EVAL_EVALUATOR_MODEL=us.anthropic.claude-sonnet-5
RAG_EVAL_ROLE_NAME=ic-agentcore-demo-rag-eval
